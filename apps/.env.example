# Copiază în `.env` la rădăcina repo-ului (același folder ca `package.json`).

# PostgreSQL (aliniază cu infra/docker-compose.yml)
DATABASE_URL="postgresql://itecify:itecify@localhost:5432/itecify?schema=public"
POSTGRES_USER=itecify
POSTGRES_PASSWORD=itecify
POSTGRES_DB=itecify
POSTGRES_PORT=5432

# API (Fastify)
API_HOST=0.0.0.0
API_PORT=3001
AUTH_COOKIE_SECURE=false

# Google Gemini (sugestii AI structurate) — nu comita cheia; setează în `.env` local.
# Suportă aceeași cheie ca în alte proiecte (Nest etc.): una dintre ele este suficientă.
# GEMINI_API_KEY=
# GOOGLE_GEN_AI_API_KEY=
# Model (implicit în cod: gemini-2.5-flash). Suprascrie dacă ai nevoie de alt model / cotă.
# GEMINI_MODEL=gemini-2.5-flash

# Runner Docker (sandbox) — opțional
# RUNNER_WORK_ROOT=
# RUNNER_TIMEOUT_MS=60000
# DOCKER_BIN=docker
# RUNNER_DOCKER_MEMORY=256m
# RUNNER_DOCKER_CPUS=1
# RUNNER_IMAGE_JS=node:20-alpine
# RUNNER_IMAGE_PYTHON=python:3.12-alpine
# RUNNER_IMAGE_JAVA=eclipse-temurin:17-jdk-jammy
# RUNNER_IMAGE_C=gcc:14-bookworm

# Collab (Yjs y-websocket pe același port HTTP + WS upgrade)
COLLAB_HOST=0.0.0.0
COLLAB_PORT=1234

# Frontend (Vite)
WEB_HOST=0.0.0.0
WEB_PORT=5173

# Folosit în browser (prefix VITE_)
VITE_API_URL=http://localhost:3001
VITE_COLLAB_WS_URL=ws://localhost:1234
