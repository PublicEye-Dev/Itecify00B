# Copiază în `.env` la rădăcina repo-ului (același folder ca `package.json`).

# PostgreSQL (aliniază cu infra/docker-compose.yml)
DATABASE_URL="postgresql://itecify:itecify@localhost:5432/itecify?schema=public"
POSTGRES_USER=itecify
POSTGRES_PASSWORD=itecify
POSTGRES_DB=itecify
POSTGRES_PORT=5432

# API (Fastify)
API_HOST=0.0.0.0
API_PORT=3001
AUTH_COOKIE_SECURE=false

# Collab (Yjs y-websocket pe același port HTTP + WS upgrade)
COLLAB_HOST=0.0.0.0
COLLAB_PORT=1234

# Frontend (Vite)
WEB_HOST=0.0.0.0
WEB_PORT=5173

# Folosit în browser (prefix VITE_)
VITE_API_URL=http://localhost:3001
VITE_COLLAB_WS_URL=ws://localhost:1234
