generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  EDITOR
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]

  ownedWorkspaces      Workspace[]         @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]

  @@index([role])
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum WorkspaceMemberRole {
  OWNER
  EDITOR
}

model Workspace {
  id                String            @id @default(cuid())
  name              String
  ownerId           String            @map("owner_id")
  template          RunTemplate
  shareToken        String            @unique @map("share_token")
  /// Ultimul snapshot Yjs serializat ca JSON (`WorkspaceSnapshotV1` sau obiect compatibil).
  snapshot          Json?
  snapshotUpdatedAt DateTime?         @map("snapshot_updated_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  owner   User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members WorkspaceMember[]
  runJobs RunJob[]
  aiSuggestions AiSuggestion[]

  @@index([ownerId])
  @@map("workspaces")
}

enum AiSuggestionStatus {
  /// Generare validă; așteaptă acțiune utilizator (accept/respinge).
  VALIDATED
  REJECTED_MALFORMED
  /// Utilizatorul a acceptat; patch-ul a fost aplicat (stare persistată).
  ACCEPTED
  /// Utilizatorul a respins sugestia.
  USER_REJECTED
}

enum AiSuggestionOperationType {
  REPLACE
  INSERT
  DELETE
}

/// Propuneri AI structurate — nu se aplică automat în editor; clientul le afișează și aplică la confirmare.
model AiSuggestion {
  id          String @id @default(cuid())
  batchId     String @map("batch_id")
  workspaceId String @map("workspace_id")

  status AiSuggestionStatus @map("status")

  filePath        String?                   @map("file_path")
  operationType   AiSuggestionOperationType? @map("operation_type")
  targetRange     Json?                     @map("target_range")
  replacementText String?                   @map("replacement_text") @db.Text
  /// Textul din interval la momentul generării (verificare conflict la accept).
  sourceSpanText  String?                   @map("source_span_text") @db.Text
  explanation     String?                   @map("explanation") @db.Text
  confidence      Float?                    @map("confidence")

  parseError   String? @map("parse_error") @db.Text
  rawCandidate Json?   @map("raw_candidate")

  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([batchId])
  @@map("ai_suggestions")
}

model WorkspaceMember {
  workspaceId String                @map("workspace_id")
  userId      String                @map("user_id")
  role        WorkspaceMemberRole   @default(EDITOR)
  createdAt   DateTime              @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@map("workspace_members")
}

enum RunTemplate {
  javascript
  python
  java
  c
}

enum RunJobStatus {
  PENDING
  MATERIALIZING
  BUILDING
  RUNNING
  SUCCEEDED
  FAILED
  TIMEOUT
  CANCELLED
}

model RunJob {
  id           String       @id @default(cuid())
  workspaceId  String       @map("workspace_id")
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template     RunTemplate
  status       RunJobStatus @default(PENDING)
  exitCode     Int?         @map("exit_code")
  errorCode    String?      @map("error_code")
  errorMessage String?      @map("error_message") @db.Text
  stdout       String       @default("") @db.Text
  stderr       String       @default("") @db.Text
  workDir      String?      @map("work_dir")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  startedAt    DateTime?    @map("started_at")
  finishedAt   DateTime?    @map("finished_at")

  @@index([workspaceId])
  @@index([status])
  @@map("run_jobs")
}
